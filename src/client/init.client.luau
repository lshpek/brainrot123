-- Client entry point: waits for the server's remotes, then boots every
-- controller. Windows (Shop, Rebirth) register themselves with the UI window
-- manager; the HUD's buttons toggle them by name.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

ReplicatedStorage:WaitForChild("Remotes")
ReplicatedStorage:WaitForChild("Shared")

local Effects = require(script.Effects)
local ShopUi = require(script.ShopUi)
local RebirthUi = require(script.RebirthUi)
local Hud = require(script.Hud)
local ZoneGates = require(script.ZoneGates)
local AttackClient = require(script.AttackClient)
local BrainrotClient = require(script.BrainrotClient)
local FartJumpClient = require(script.FartJumpClient)
local PetUi = require(script.PetUi)
local PetFollower = require(script.PetFollower)
local WorldsUi = require(script.WorldsUi)
local AdminUi = require(script.AdminUi)
local QuestsUi = require(script.QuestsUi)
local PvPUi = require(script.PvPUi)
local Onboarding = require(script.Onboarding)

Effects.start()
ShopUi.build()
RebirthUi.build()
PetUi.build()
PetFollower.start()
WorldsUi.build()
AdminUi.build()
QuestsUi.build()
PvPUi.build()
Hud.start()
ZoneGates.start()
AttackClient.start()
BrainrotClient.build()
FartJumpClient.start()
Onboarding.build()
