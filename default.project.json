{
  "name": "FartBrainrotSimulator",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Lighting": {
      "$properties": {
        "Brightness": 2,
        "ClockTime": 14
      }
    },
    "Workspace": {
      "$ignoreUnknownInstances": true
    }
  }
}
